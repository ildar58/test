{
  "name": "@pam/web-session-recorder",
  "version": "0.2.0",
  "private": true,
  "description": "rrweb-based session recorder — source for the IIFE bundle served by the nginx proxy",
  "repository": {
    "type": "git",
    "url": "https://github.com/ildar58/test",
    "directory": "sdk"
  },
  "license": "MIT",
  "author": "Ildar Dautov",
  "keywords": ["rrweb", "session-replay", "session-recording", "monitoring"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=PamRecorder --outfile=dist/recorder.iife.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --global-name=PamRecorder --outfile=dist/recorder.iife.js --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rrweb/types": "^2.0.0-alpha.13",
    "fflate": "^0.8.2",
    "rrweb": "^2.0.0-alpha.13"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
